# ============================================================================
#  api/.htaccess — a végpontok könyvtárának védelme
# ----------------------------------------------------------------------------
#  Ebben a könyvtárban a PHP-végpontokon kívül olyan állományok is élnek,
#  amelyeket a böngészőnek SOHA nem szabad megkapnia: a konfiguráció, a
#  hibanapló, a sebességkorlát nyilvántartása és — ha ide teszed — az
#  API-kulcsot tartalmazó szövegfájl.
#
#  A PHP-fájlokat a szerver futtatja, tehát a forrásuk nem jut ki; a .txt, a
#  .log és a .example.php viszont sima szövegként letölthető volna. Ez a fájl
#  ezt tiltja meg.
#
#  ⚠️ EZ A VÉDELEM CSAK APACHE ALATT MŰKÖDIK. Ha a tárhely nginx-et használ (a
#  .htaccess-t nem olvassa), akkor a kulcsfájlt a webgyökér FÖLÉ tedd —
#  `oth-titkok/ai-kulcs.txt` —, ahogy a config.php első keresési helye mutatja.
#  Ami nincs a dokumentumgyökérben, azt a szerver nem tudja kiszolgálni.
# ============================================================================

# Titkok és belső állományok: semmilyen körülmények között nem szolgálhatók ki.
<FilesMatch "\.(txt|log|json|ini|example\.php)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# A config.php-t a PHP futtatja, de ha a PHP-feldolgozó valaha kiesne, a
# forrása nyersen kimenne. Közvetlen kérésre soha nincs rá szükség.
<Files "config.php">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</Files>

# Rejtett fájlok és könyvtárak (.ratelimit, .ai-kulcs, szerkesztői maradványok).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule (^|/)\. - [F]
</IfModule>

# A végpontok kiterjesztés nélkül is hívhatók (api/ajanlat-jelentes), ahogy a
# kliens hivatkozik rájuk.
<IfModule mod_rewrite.c>
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}\.php -f
  RewriteRule ^([^/.]+)$ $1.php [L]
</IfModule>

# A könyvtár tartalma nem listázható.
Options -Indexes
