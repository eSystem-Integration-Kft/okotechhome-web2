# =============================================================================
# ÖkoTech Home — Test2 · Apache konfiguráció
# Clean URL (kiterjesztés nélküli útvonalak) + biztonsági fejlécek + cache
#
# FIGYELEM: ez rejtett dotfile. Az FTP-kliensek és a ZIP-csomagolók alapból
# kihagyják. Ha élesben minden link 404-el, jellemzően ez maradt le.
# =============================================================================

Options -Indexes +FollowSymLinks
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # ===========================================================================
  # RÉGI DOMAIN → ÚJ DOMAIN (Google Ads céloldalak)
  # ---------------------------------------------------------------------------
  # A Google Ads hirdetésekbe a RÉGI webhely URL-jei vannak beégetve
  # (okotechhome.hu). Élesítés után minden ilyen kattintás 404-re futna, a
  # Google pedig a nem működő céloldalú hirdetést „Destination not working"
  # címen ELUTASÍTJA — a kampány leállhat. Ezért ezeknek a szabályoknak MÁR AZ
  # ÁTÁLLÁS PILLANATÁBAN élniük kell, nem utólag.
  #
  # HOL FUT LE EZ A BLOKK? Csak akkor, ha a kérés a RÉGI domainre érkezik, és
  # az a domain EZT a kiszolgálót éri el. Ha az okotechhome.hu máshol marad,
  # ugyanezeket a szabályokat A RÉGI KISZOLGÁLÓ .htaccess-ébe kell betenni —
  # ott a cél már abszolút URL, ahogy itt is.
  #
  # A lekérdezőstringet (?gclid=…) az Apache alapból hozzáfűzi a célhoz, tehát
  # az Ads kattintáskövetése nem sérül.
  #
  # A záró perjel MINDKÉT alakra illeszkedik (`/?$`): a régi webhelyen
  # következetlen volt.
  # ===========================================================================
  RewriteCond %{HTTP_HOST} ^(www\.)?okotechhome\.hu$ [NC]
  RewriteRule ^biologiai-szenyviztisztito-1-50-foig/?$            https://okoth.hu/megoldasok/biologiai-szennyviztisztitas [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^(www\.)?okotechhome\.hu$ [NC]
  RewriteRule ^szennyviztisztito-oldomedencek/?$                  https://okoth.hu/megoldasok/oldomedences-rendszer [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^(www\.)?okotechhome\.hu$ [NC]
  RewriteRule ^a-szennyviztisztito-telepitese-lepesrol-lepesre/?$ https://okoth.hu/tudastar/telepites-lepesrol-lepesre [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^(www\.)?okotechhome\.hu$ [NC]
  RewriteRule ^az-iszapzsakos-szennyviztisztito-elonyei/?$        https://okoth.hu/megoldasok/ab-clear-iszapzsakos-technologia [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^(www\.)?okotechhome\.hu$ [NC]
  RewriteRule ^oldomedence-kontra-biologiai-szennyviztisztito/?$  https://okoth.hu/tudastar/oldomedence-vagy-biologiai-szennyviztisztito [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^(www\.)?okotechhome\.hu$ [NC]
  RewriteRule ^javasolt-tisztitoszerek/?$                         https://okoth.hu/tudastar/tisztitoszerek [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^(www\.)?okotechhome\.hu$ [NC]
  RewriteRule ^biologiai-szennyviztisztito-telepek/?$             https://okoth.hu/megoldasok/nagyobb-es-kozossegi-rendszerek [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^(www\.)?okotechhome\.hu$ [NC]
  RewriteRule ^formok/ajanlatkeres\.php$                          https://okoth.hu/ajanlat [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^(www\.)?okotechhome\.hu$ [NC]
  RewriteRule ^muszaki/?$                                         https://okoth.hu/megoldasok/ab-clear-muszaki-adatok [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^(www\.)?okotechhome\.hu$ [NC]
  RewriteRule ^referenciaink/?$                                   https://okoth.hu/eredmenyek/esettanulmanyok [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^(www\.)?okotechhome\.hu$ [NC]
  RewriteRule ^cegunkrol/?$                                       https://okoth.hu/okotech-home/tortenetunk [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^(www\.)?okotechhome\.hu$ [NC]
  RewriteRule ^elszivarogtatas/?$                                 https://okoth.hu/projekt-elokeszites/elszivarogtatas [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^(www\.)?okotechhome\.hu$ [NC]
  RewriteRule ^kiknek/?$                                          https://okoth.hu/megoldasok/biologiai-szennyviztisztitas [R=301,L,NE]

  # Ami a fenti listából kimaradt, két lépcsőben dől el.
  #
  # 1) HA UGYANAZ AZ ÚTVONAL LÉTEZIK az új webhelyen, oda megy — nem a
  #    főoldalra. Ez akkor számít, amikor a régi domain már EZT a webhelyet
  #    szolgálja ki: olyankor az `okotechhome.hu/megoldasok/ab-clear` egy
  #    ÉLŐ lap címe, és bűn volna a főoldalra dobni.
  RewriteCond %{HTTP_HOST} ^(www\.)?okotechhome\.hu$ [NC]
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f [OR]
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+?)/?$ https://okoth.hu/$1 [R=301,L,NE]

  # 2) Minden más a főoldalra — jobb, mint a 404. A régi sitemap többi URL-jét
  #    külön kell felmérni; addig ez a háló.
  RewriteCond %{HTTP_HOST} ^(www\.)?okotechhome\.hu$ [NC]
  RewriteRule ^(.*)$ https://okoth.hu/ [R=301,L,NE]

  # ALKÖNYVTÁRAS TELEPÍTÉS
  # A site domaingyökérben és alkönyvtárban (pl. /_work/oko22/) is működik.
  # Ehhez az átirányítások célja RELATÍV — a `RewriteBase`-hez, illetve annak
  # hiányában a kérés útjához igazodik. Ha az Apache mégis a gyökérbe dobná a
  # 301-eket, vedd ki a kommentet és írd át az elérési útra:
  # RewriteBase /_work/oko22/

  # --- 1a) index.html a kanonikus gyökérre ---------------------------------
  # Külön szabály: e nélkül az általános .html-levágás /index-re küldene,
  # ami működne ugyan, de két URL-en lenne elérhető a főoldal.
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^ %1 [R=301,L,NE]

  # --- 1b) A .html kiterjesztés levágása -------------------------------------
  # Ha a látogató mégis /valami.html-t kér, 301-gyel a tiszta URL-re küldjük.
  # A %{THE_REQUEST} vizsgálat kell, hogy a belső rewrite ne indítson hurkot.
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
  RewriteRule ^ %1 [R=301,L,NE]

  # --- 2) Kiterjesztés nélküli útvonal kiszolgálása a .html fájlból ----------
  # Csak akkor, ha nem létező könyvtárra vagy fájlra mutat, és a .html létezik.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]

  # --- 3) Záró perjel eltávolítása (a duplikált URL-ek elkerüléséért) -------
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ $1 [R=301,L,NE]
</IfModule>

# --- Egyedi hibaoldalak -------------------------------------------------------
# Mind a négy oldal ÖNHORDÓ (beágyazott stílus és logó), mert a böngésző a
# relatív útvonalakat a KÉRT URL-hez oldja fel, nem a hibaoldal helyéhez:
# /megoldasok/nincs-ilyen kérésnél az assets/... hivatkozás /megoldasok/assets/...
# lenne, ami szintén 404. Lásd scripts/oldalgyartas/hibaoldalak.py.
#
# ALKÖNYVTÁRAS TELEPÍTÉSNÉL az alábbi négy útvonal elé az alkönyvtár is kell
# (pl. /oko22/404.html), és a hibaoldalak gyökér-abszolút hivatkozásait is.
ErrorDocument 401 /401.html
ErrorDocument 403 /403.html
ErrorDocument 404 /404.html
ErrorDocument 500 /500.html

# A könyvtárlisták kikapcsolása — enélkül a kép- és ikonkönyvtárak tartalma
# böngészhető lenne. A tiltás 403-at ad, amit a fenti hibaoldal fog el.
Options -Indexes

# --- Biztonsági fejlécek ------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # CSP — a betűkészletek a Google Fonts-ról jönnek (designrendszer 1. fejezet).
  # Ha új külső forrás kerül az oldalra, ITT kell engedélyezni.
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; img-src 'self' data:; frame-src https://www.google.com; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self'"

  # HSTS — CSAK éles, HTTPS-en kiszolgált domainen kapcsold be.
  # Staging vagy HTTP alatt hagyd kikommentezve.
  # Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"

  # --- Kapcsolat oldalak: az élő Google-térkép többletforrásai ---------------
  # A Maps JavaScript API saját szkriptet, csempéket és betűket tölt be, ezért
  # a szigorú alapszabály itt nem elég. A bővítés SZÁNDÉKOSAN csak a térképes
  # lapokra érvényes: a webhely többi lapja marad a szűk listán.
  #
  # MINDEN NYELV KAPCSOLAT OLDALA SZEREPELJEN ITT. A `<Files>` a fájlnévre
  # illeszkedik, nem az útvonalra, ezért egy nyelvi klón más nevet kap
  # (`kapcsolat.html` → `en/contact.html`), és kimarad a listából. Ez már
  # megtörtént: az angol lap a szűk alapszabályt kapta, a böngésző letiltotta
  # a `maps.googleapis.com` szkriptet, a lap visszaesett a beágyazott keretre,
  # és a látogató a Google alapértelmezett, POI-kkal teli térképét kapta a
  # márkaszínű helyett. A hiba NÉMA: a lapon térkép van, csak nem a mienk —
  # és a hálózati naplóban a Maps-kérés `503`-nak látszik, mintha a Google
  # utasítaná el. Nem ő: `curl`-lel ugyanaz a kérés `200`.
  #
  # A `style-src 'unsafe-inline'` a legdrágább tétel — a Maps a saját elemeit
  # beágyazott stílussal formázza. Ha a térkép nélküle is hibátlanul megjelenik
  # (a böngésző konzoljában nincs CSP-hiba), vedd ki: a beágyazott stílus
  # engedélyezése egy XSS-hez való támadási felület, még ha csak stíluson át is.
  #
  # Ha a `data-terkep-kulcs` üres, az egész blokk fölösleges — akkor a lap a
  # beágyazott keretet használja, amihez a `frame-src` már megvan fent.
  <FilesMatch "^(kapcsolat|contact)\.html$">
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; img-src 'self' data: blob: https://*.googleapis.com https://*.gstatic.com https://*.ggpht.com; frame-src https://www.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' https://maps.googleapis.com https://maps.gstatic.com; connect-src 'self' https://maps.googleapis.com https://*.googleapis.com; worker-src 'self' blob:"
  </FilesMatch>
</IfModule>

# --- Tömörítés ----------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript
  AddOutputFilterByType DEFLATE application/json image/svg+xml text/xml
</IfModule>

# --- Cache --------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  # A DOKUMENTUMOK NEM KAPNAK EGY ÉVET. Egy tanúsítvány megújul, és a fájl
  # ilyenkor UGYANAZON a néven cserélődik — egy éves gyorsítótárral a látogató
  # még hónapokig a lejártat töltené le. Egy hónap elég ahhoz, hogy ne terhelje
  # a kiszolgálót, és elég rövid ahhoz, hogy a csere átérjen.
  ExpiresByType application/pdf "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType video/webm "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
</IfModule>

# A statikus eszközök cache-bustingja a ?v=NN query-vel történik (app.css?v=1).
# FIGYELEM: az AI-döntéstámogató árértékei az assets/data/aidt-konfig.js fájlban élnek,
# amit szintén egy év cache véd — szerkesztés után a ?v= verziót emelni kell az index.html-ben.
# Külső (nem saját domainre mutató) adatküldési végpontnál a fenti CSP-t bővíteni kell:
# connect-src 'self' <a-végpont-domainje>


# =============================================================================
# KERESŐK ÉS AI-BOTOK — "letöltés igen, hasznosítás nem"
# -----------------------------------------------------------------------------
# Érvényes MINDKÉT domainre (tst.okoth.hu és okoth.hu), mert ugyanez a fájl
# települ mindkettőre. Két, egymást kiegészítő réteg:
#
#   A) X-ROBOTS-TAG — minden válaszon, minden kliensnek. A LETÖLTÉST NEM
#      akadályozza (azt a robots.txt szándékosan engedi), csak az indexelést,
#      az archiválást és a kivonatolást tiltja. A max-snippet / max-*-preview
#      korlátok a GEO (AI-áttekintés) ellen valók: amiből nem idézhető
#      részlet, azt az AI-válaszgeneráló sem építheti be a feleletébe.
#      A `noai`/`noimageai` nem szabvány, de több gyűjtő figyeli — nem árt.
#
#   B) UA-SZŰRŐ — az AI-tanító, AI-kereső és SEO-elemző botok 403-at kapnak,
#      tehát le sem tölthetik a lapot. A robots.txt csak kérés, ez viszont a
#      szerveren zár. A névsor a robots.txt 2. és 3. blokkjával AZONOS:
#      ha ott bővítesz, IDE IS vedd fel.
#
# ÉLESÍTÉSKOR (amikor az okoth.hu indexelhetővé válik): CSAK az A) blokk
# X-Robots-Tag sorát töröld, és a lapok <meta name="robots"> sorát cseréld.
# A B) blokk élesben is MARAD.
#
# Ellenőrzés:
#   curl -I https://okoth.hu/                       → X-Robots-Tag: noindex, …
#   curl -I -A "GPTBot/1.2" https://okoth.hu/       → 403
#   curl -I -A "AhrefsBot/7.0" https://okoth.hu/    → 403
#   curl -I -A "Googlebot/2.1" https://okoth.hu/    → 200 (letöltheti, de noindex)
# =============================================================================

# --- A) Indexelés, archiválás és kivonatolás tiltása --------------------------
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex, notranslate, max-snippet:0, max-image-preview:none, max-video-preview:0, noai, noimageai"
</IfModule>

# --- B) AI- és SEO-botok kizárása magából a letöltésből -----------------------
# A minta RÉSZLEGES illesztés, kis-nagybetűre érzéketlen, ezért a verziószámos
# alakok is fennakadnak rajta ("ClaudeBot/1.0", "GPTBot/1.2").
# SZÁNDÉKOSAN NINCS a listán olyan köznévi ügynöknév, amely ártatlan kliensben
# is előfordulhat (pl. az OpenAI "Operator"-a) — a robots.txt ott pontos névre
# illeszt, itt egy ilyen minta valódi látogatót is kizárhatna.
<IfModule mod_setenvif.c>
  # AI-tanító és AI-kereső (GEO) ügynökök
  SetEnvIfNoCase User-Agent "(GPTBot|OAI-SearchBot|ChatGPT-User|ClaudeBot|Claude-Web|Claude-User|Claude-SearchBot|anthropic-ai|Google-Extended|GoogleOther|Applebot-Extended|Bingbot-Extended|PerplexityBot|Perplexity-User)" oth_bot_tiltva
  SetEnvIfNoCase User-Agent "(meta-externalagent|meta-externalfetcher|FacebookBot|Bytespider|TikTokSpider|Amazonbot|PanguBot|PetalBot|DuckAssistBot|MistralAI-User|cohere-ai|cohere-training-data-crawler|YouBot|AI2Bot|Kangaroo Bot|Timpibot|NovaAct|ProRataInc)" oth_bot_tiltva
  # Adathalmaz-építő és tartalomkinyerő crawlerek
  SetEnvIfNoCase User-Agent "(CCBot|Diffbot|omgili|Webzio-Extended|ImagesiftBot|img2dataset|iaskspider|VelenPublicWebCrawler|Scrapy|QuillBot|ISSCyberRiskCrawler|Sidetrade indexer bot)" oth_bot_tiltva
  # SEO-elemző, backlink- és versenytárs-figyelő botok
  SetEnvIfNoCase User-Agent "(AhrefsBot|AhrefsSiteAudit|SemrushBot|SiteAuditBot|MJ12bot|DotBot|rogerbot|BLEXBot|Barkrowler|DataForSeoBot|serpstatbot|SEOkicks|SEOlyticsCrawler|linkdexbot|spbot|Screaming Frog SEO Spider|ZoominfoBot|Awario|magpie-crawler|peer39_crawler|TurnitinBot|Sogou web spider)" oth_bot_tiltva
</IfModule>

# A 403-at az ErrorDocument 403 fogja el; a hibaoldal maga is noindex.
<IfModule mod_authz_core.c>
  <RequireAll>
    Require all granted
    Require not env oth_bot_tiltva
  </RequireAll>
</IfModule>
<IfModule !mod_authz_core.c>
  Order allow,deny
  Allow from all
  Deny from env=oth_bot_tiltva
</IfModule>

# KIVÉTEL: a robots.txt és a 403-as hibaoldal MINDENKINEK kimegy, a tiltott
# botnak is. Ez nem kiskapu, hanem a tiltás feltétele: a jól nevelt gyűjtő a
# robots.txt-ben olvassa a saját nevét, és el sem indul. Ha 403-at kapna, az
# RFC 9309 szerint "elérhetetlen robots.txt" volna — amit a szabvány úgy
# értelmez, hogy a webhelyen NINCS korlátozás. A <Files> szűkebb kontextus,
# ezért felülírja a fenti RequireAll-t.
<Files "robots.txt">
  Require all granted
</Files>
<Files "403.html">
  Require all granted
</Files>

# Jelszavas védelem — SZÁNDÉKOSAN KIKAPCSOLVA: a döntés szerint a letöltés
# (a lapok elérése, a fájlok lehívása) szabad marad, csak a botok tevékenysége
# tiltott. Ha mégis teljes zárás kell, készíts .htpasswd fájlt a webgyökér
# FÖLÖTT — htpasswd -c /home/USER/.htpasswd tesztelo — és vedd ki a jeleket:
# AuthType Basic
# AuthName "Fejlesztes alatt"
# AuthUserFile /home/USER/.htpasswd
# Require valid-user

# --- Verziózási és dokumentációs fájlok kizárása -------------------------------
<FilesMatch "\.(md|py|sh|sql)$">
  Require all denied
</FilesMatch>
